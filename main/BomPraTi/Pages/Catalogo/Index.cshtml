@page "/catalogo"
@model BomPraTi.Pages.Catalogo.IndexModel
@{
    ViewData["Title"] = "Catálogo canônico";
}

<div class="container py-4">
    <h1>Catálogo canônico</h1>
    <p>Crie ou reutilize a identidade automotiva canônica usada pelos anúncios.</p>

    @if (Model.CreatedVehicleId.HasValue)
    {
        <div class="alert alert-success" role="status" data-created-vehicle-id="@Model.CreatedVehicleId">
            Vehicle canônico disponível: <code>@Model.CreatedVehicleId</code>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <ul class="mb-0">
            @foreach (var state in ViewData.ModelState.Values)
            {
                foreach (var error in state.Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            }
            </ul>
        </div>
    }

    <form method="post" action="/catalogo?handler=Create" class="row g-3 mt-1">
        @Html.AntiForgeryToken()

        <div class="col-md-6">
            <label for="BrandName" class="form-label">Marca</label>
            <input id="BrandName" name="BrandName" class="form-control" maxlength="128" value="@Model.BrandName" required />
        </div>

        <div class="col-md-6">
            <label for="ModelName" class="form-label">Modelo</label>
            <input id="ModelName" name="ModelName" class="form-control" maxlength="128" value="@Model.ModelName" required />
        </div>

        <div class="col-md-6">
            <label for="GenerationName" class="form-label">Geração <span class="text-muted">(opcional)</span></label>
            <input id="GenerationName" name="GenerationName" class="form-control" maxlength="128" value="@Model.GenerationName" />
        </div>

        <div class="col-md-3">
            <label for="GenerationStartYear" class="form-label">Início da geração</label>
            <input id="GenerationStartYear" name="GenerationStartYear" type="number" class="form-control" value="@Model.GenerationStartYear" />
        </div>

        <div class="col-md-3">
            <label for="GenerationEndYear" class="form-label">Fim da geração</label>
            <input id="GenerationEndYear" name="GenerationEndYear" type="number" class="form-control" value="@Model.GenerationEndYear" />
        </div>

        <div class="col-md-8">
            <label for="VersionName" class="form-label">Versão</label>
            <input id="VersionName" name="VersionName" class="form-control" maxlength="180" value="@Model.VersionName" required />
        </div>

        <div class="col-md-4">
            <label for="ModelYear" class="form-label">Ano modelo <span class="text-muted">(opcional)</span></label>
            <input id="ModelYear" name="ModelYear" type="number" class="form-control" value="@Model.ModelYear" />
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Criar identidade canônica</button>
            <a class="btn btn-outline-secondary ms-2" href="/admin">Voltar para operações</a>
        </div>
    </form>
</div>
