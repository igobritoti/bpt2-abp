@page "/admin"
@model BomPraTi.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Operações administrativas";
}

<div class="container py-4">
    <h1>Operações administrativas</h1>
    <p>Resumo operacional e acesso às superfícies internas já disponíveis no Bom Pra Ti.</p>

    <div class="row g-3 mt-2">
        <div class="col-md-6">
            <section class="card h-100" aria-labelledby="catalogo-title">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <h2 id="catalogo-title" class="h4">Catálogo canônico</h2>
                        <span class="badge text-bg-secondary" data-admin-metric="canonical-vehicles" data-admin-count="@Model.CanonicalVehicleCount">@Model.CanonicalVehicleCount</span>
                    </div>
                    <p class="card-text"><strong>Vehicles canônicos:</strong> @Model.CanonicalVehicleCount</p>
                    <p class="card-text">Crie a identidade automotiva canônica necessária para novos anúncios.</p>
                    <a class="btn btn-primary mt-auto align-self-start" href="/catalogo">Abrir catálogo</a>
                </div>
            </section>
        </div>
        <div class="col-md-6">
            <section class="card h-100" aria-labelledby="moderacao-title">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <h2 id="moderacao-title" class="h4">Moderação de anúncios</h2>
                        <span class="badge text-bg-secondary" data-admin-metric="moderation-reports" data-admin-count="@Model.ModerationReportCount">@Model.ModerationReportCount</span>
                    </div>
                    <p class="card-text"><strong>Reports recebidos:</strong> @Model.ModerationReportCount</p>
                    <p class="card-text">Consulte o histórico de reports recebidos sobre anúncios.</p>
                    <a class="btn btn-primary mt-auto align-self-start" href="/moderacao">Abrir moderação</a>
                </div>
            </section>
        </div>
        <div class="col-md-6">
            <section class="card h-100" aria-labelledby="ingestao-title">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <h2 id="ingestao-title" class="h4">Ingestão de veículos</h2>
                        <span class="badge text-bg-secondary" data-admin-metric="pending-ingestion" data-admin-count="@Model.PendingIngestionCount">@Model.PendingIngestionCount</span>
                    </div>
                    <p class="card-text"><strong>Candidates pendentes:</strong> @Model.PendingIngestionCount</p>
                    <p class="card-text">Reconcilie candidates externos com Vehicles canônicos.</p>
                    <a class="btn btn-primary mt-auto align-self-start" href="/ingestao">Abrir ingestão</a>
                </div>
            </section>
        </div>
    </div>
</div>
